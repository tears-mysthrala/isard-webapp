# IsardVDI Manager - example environment configuration.
# Copy this file to `.env` and adjust the values. `.env` is git-ignored:
# never commit real credentials or tokens.

# Base URL of the IsardVDI API (v3). Override only if you run your own
# IsardVDI deployment; the default points to the UPV/EHU cloud instance.
ISARD_API_BASE_URL=https://cloud.uni.eus/api/v3

# Flask session signing key. Generate a long random value for any shared or
# long-lived deployment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated on each start (sessions are invalidated
# on every restart).
SECRET_KEY=change-me-to-a-long-random-string

# Port the app listens on (default: 5000).
PORT=5000

# Enable Flask debug mode. NEVER enable this outside local development:
# the debugger allows arbitrary code execution on the host.
FLASK_DEBUG=false

# Note: your personal IsardVDI API key is NOT configured here. It is entered
# in the web login form and kept only in the server-side session; it is never
# written to disk by the application.
